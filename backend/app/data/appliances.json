      "is_high_power": false,
      "always_on": false,
      "efficiency_note_zh": "電視待機功率低但仍持續消耗，長時間不使用建議關閉電源。",
      "efficient_alternative": {
        "label_zh": "一級能效液晶電視",
        "power_watts": 70,
        "note_zh": "新機種面板效率較佳，待機功率也更低。"
      },
      "rules": []
    },
    {
      "key": "electric_heater",
      "name_en": "Electric space heater",
      "name_zh": "電暖器",
      "category": "heating",
      "typical_power_watts": 1200,
      "power_range_watts": [600, 1500],
      "voltage_v": 110,
      "typical_hours_per_day": 3,
      "typical_days_per_month": 30,
      "is_high_power": true,
      "always_on": false,
      "efficiency_note_zh": "電暖器屬於電阻式加熱，1W 電力最多產生 1W 熱能，效率無法再提升，只能減少使用時間。",
      "efficient_alternative": {
        "label_zh": "變頻冷暖氣機（暖氣模式）",
        "power_watts": 800,
        "note_zh": "熱泵效率大於 1，同樣熱量下用電量通常低於電暖器。"
      },
      "rules": [
        {
          "id": "heater_high_power",
          "when": { "is_high_power": true },
          "title_zh": "電暖器為高功率電阻式加熱",
          "reason_zh": "電暖器功率高且效率已達理論上限，只能靠減少使用時間節電。",
          "suggestion_zh": "改用冷暖氣機暖氣模式，或以衣物、地墊保暖並縮小加熱空間。",
          "reduction_ratio": 0.35,
          "priority": 1,
          "severity": "high"
        }
      ]
    }
  ]
}
